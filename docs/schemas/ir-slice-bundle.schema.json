{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ir-slice-bundle.schema.json",
  "title": "IR Slice Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slice_id",
    "program_id",
    "slice_type",
    "target_role",
    "readiness_state",
    "source_provenance",
    "ir_fragment_ref",
    "allowed_target_files",
    "allowed_edit_zones",
    "acceptance_checks"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "application_id": {"type": "string"},
    "domain_id": {"type": "string"},
    "qualification_batch_id": {"type": "string"},
    "slice_type": {
      "type": "string",
      "enum": [
        "paragraph_cluster",
        "statement_family_hotspot",
        "data_structure_mapping",
        "file_interaction_block",
        "sql_interaction_block",
        "packaging_scaffold"
      ]
    },
    "target_microservice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_name"],
      "properties": {
        "service_name": {"type": "string"},
        "module": {"type": "string"},
        "package": {"type": "string"}
      }
    },
    "target_role": {
      "type": "string",
      "enum": [
        "domain_service_component",
        "job_orchestration_component",
        "api_adapter_component",
        "data_access_component",
        "shared_support_component",
        "manual_remediation_component",
        "unknown_needs_review"
      ]
    },
    "readiness_state": {
      "type": "string",
      "enum": [
        "ready_for_scaffold",
        "ready_for_claude_code",
        "blocked_on_parser",
        "blocked_on_ir",
        "blocked_on_runtime",
        "blocked_on_codegen_template",
        "blocked_on_fixture_data",
        "manual_review_required"
      ]
    },
    "source_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "copybook": {"type": "boolean"}
        }
      }
    },
    "cobol_excerpts": {"type": "array", "items": {"type": "object"}},
    "copybook_excerpts": {"type": "array", "items": {"type": "object"}},
    "ir_fragment_ref": {"type": "string", "minLength": 1},
    "dependency_summary": {"type": "array", "items": {"type": "object"}},
    "runtime_contracts": {"type": "array", "items": {"type": "object"}},
    "allowed_target_files": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_edit_zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "zone_id"],
        "properties": {
          "file": {"type": "string"},
          "zone_id": {"type": "string"},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1}
        }
      }
    },
    "acceptance_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile_required", "static_analysis_required", "tests"],
      "properties": {
        "compile_required": {"type": "boolean"},
        "static_analysis_required": {"type": "boolean"},
        "golden_master_required": {"type": "boolean"},
        "tests": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "known_uncertainties": {"type": "array", "items": {"type": "string"}},
    "escalation_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["parser", "ir", "runtime", "codegen", "verification", "environment", "manual_redesign"]
      }
    },
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
