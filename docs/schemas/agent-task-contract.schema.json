{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent-task-contract.schema.json",
  "title": "Agent Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "slice_id",
    "program_id",
    "target_role",
    "purpose",
    "allowed_target_files",
    "allowed_edit_zones",
    "stop_conditions",
    "acceptance_checks",
    "retry_budget"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "task_id": {"type": "string"},
    "task_type": {"type": "string", "enum": ["human-agent-bounded-implementation", "remediate_slice", "author_template_change", "review_generated_output", "investigate_verification_failure"]},
    "slice_id": {"type": "string"},
    "program_id": {"type": "string"},
    "target_role": {"type": "string"},
    "purpose": {"type": "string"},
    "input_artifact_refs": {"type": "array", "items": {"type": "string"}},
    "allowed_target_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_edit_zones": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "retry_budget": {"type": "integer", "minimum": 0},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}